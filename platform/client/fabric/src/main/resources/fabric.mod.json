{
  "schemaVersion": 1,
  "id": "dreamdisplays",
  "name": "Dream Displays",
  "version": "${version}",
  "license": "LGPL-3.0",
  "description": "AltDisplays by GRAZ: in-game screens with server-set sound range. Based on Dream Displays by arnodoelinger, INotSleep, Kolyakot33 and Toffikk.",
  "authors": [
    "GRAZ"
  ],
  "contributors": [
    "arnodoelinger", "INotSleep", "Kolyakot33", "Toffikk"
  ],
  "contact": {
    "homepage": "https://github.com/xGRAZx/dreamdisplays",
    "sources": "https://github.com/xGRAZx/dreamdisplays",
    "issues": "https://github.com/xGRAZx/dreamdisplays/issues"
  },
  "entrypoints": {
    "client": [
      "com.dreamdisplays.platform.client.Client"
    ],
    "main": [
      "com.dreamdisplays.platform.server.Server"
    ],
    "modmenu": [
      "com.dreamdisplays.platform.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dreamdisplays.mixins.json",
    "dreamdisplays.server.mixins.json"
  ],
  "accessWidener": "dreamdisplays.classtweaker",
  "depends": {
    "fabricloader": ">=${fabricLoaderMin}",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  },
  "suggests": {
    "luckperms": "*",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "icon": "assets/dreamdisplays/icon.png"
}
